# Copy to .env. Never commit .env or Telegram session files.
DARK_MCP_DATA_DIR=./data
DARK_MCP_TOR_PROXY=socks5h://127.0.0.1:9050
DARK_MCP_REQUEST_TIMEOUT=45
DARK_MCP_MAX_RESPONSE_BYTES=2000000
DARK_MCP_MAX_TEXT_CHARS=60000
# Obtain a search provider key at https://onionsearchengine.com/api_plans.php.
# DARK_MCP_ONION_SEARCH_API_KEY=replace-locally

# Obtain your own credentials at https://my.telegram.org/apps.
# Uncomment and supply actual values locally before telegram-login.
# DARK_MCP_TELEGRAM_API_ID=123456
# DARK_MCP_TELEGRAM_API_HASH=replace-locally
DARK_MCP_TELEGRAM_ENABLED=false
# JSON list of permitted channel usernames or -100-prefixed IDs.
DARK_MCP_TELEGRAM_CHANNELS=[]
# Separately permits discovery and public post search across channels.
DARK_MCP_TELEGRAM_GLOBAL_SEARCH=false
